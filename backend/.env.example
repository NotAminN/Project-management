# Production Environment Configuration Example
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

# PostgreSQL Database URL for Production Deployment (e.g. Render, Railway, Supabase, Neon)
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# CORS settings for Frontend production domain
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://frontend.vercel.app

# SSL Security (Set to True in HTTPS Production)
SECURE_SSL_REDIRECT=True
